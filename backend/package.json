{
  "name": "smaj-pi-hub-backend",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Backend services for SMAJ PI HUB marketplace, Pi authentication, payments, messaging, and operations.",
  "author": {
    "name": "SMAJ PI HUB"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "start": "ts-node-dev ./src/index.ts",
    "test:validation": "ts-node ./src/tests/storageValidation.test.ts",
    "test:jobs": "ts-node ./src/tests/jobsValidation.test.ts",
    "test:orders": "ts-node ./src/tests/orderLifecycle.test.ts",
    "sessions:cleanup": "ts-node ./src/scripts/cleanupUserSessions.ts",
    "storage:report": "ts-node ./src/scripts/storageReport.ts",
    "storage:migrate-images": "ts-node ./src/scripts/migrateBase64ImagesToCloudinary.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "firebase-admin": "^13.10.0",
    "mongodb": "^6.12.0",
    "morgan": "^1.10.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.18.2",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.7",
    "@types/web-push": "^3.6.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
