# Generate a random string, or roll your face on the keyboard to fill this value:
SESSION_SECRET=

# Get this on the Pi Developer Portal (https://develop.pinet.com in the Pi Browser)
PI_API_KEY=

# Platform API 
PLATFORM_API_URL=https://api.minepi.com

# MongoDB database connection details:
# Render/MongoDB Atlas production should use this full URI.
# Example: mongodb+srv://smajpihub:YOUR_PASSWORD@smajpihub.lkfvpvv.mongodb.net/smajpihub?retryWrites=true&w=majority&appName=smajpihub
MONGODB_URI=

# Legacy/local MongoDB settings used only when MONGODB_URI is empty.
MONGO_HOST=localhost:27017
MONGODB_DATABASE_NAME=demoapp-development
MONGODB_USERNAME=demoapp
MONGODB_PASSWORD=dev_password

# Frontend app URL. Use comma-separated origins for production + local previews.
FRONTEND_URL=https://smajpihub.com,https://www.smajpihub.com,https://smaj.org,https://www.smaj.org,http://localhost:3314,http://localhost:5173

# Local-only memory database. Keep false in production and use MongoDB.
USE_MEMORY_DB=false

# Local-only auth shortcut. Keep false in production.
DEV_AUTH=false

# Comma-separated Pi usernames that should become admins after Pi login
ADMIN_PI_USERNAMES=smajadmin

# Auto-approve marketplace products after seller submit. Use true only for local testing or controlled MVP pilots.
MARKETPLACE_AUTO_APPROVE_PRODUCTS=false

# Optional production image storage. Use an unsigned Cloudinary upload preset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=smajpihub

# Sports data provider (TheSportsDB). Leave empty to use demo data.
SPORTS_PROVIDER=thesportsdb
SPORTS_API_KEY=
SPORTS_LEAGUE_IDS=
SPORTS_CACHE_SECONDS=900

# Real-time sports news provider (NewsAPI.org). Leave empty to skip news fetching.
NEWS_API_KEY=

# Self-hosted LibreTranslate base URL. API key is optional for private instances.
TRANSLATION_API_URL=http://localhost:5000
TRANSLATION_API_KEY=

# Server-side Google Places API (New) key for transport address autocomplete.
# Restrict this key to the Places API and your production server IP where possible.
GOOGLE_MAPS_API_KEY=

# Free Web Push credentials. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@smajpihub.com

# Firebase Admin credentials for native Android push notifications.
# Copy these from the downloaded service-account JSON. Keep the private key secret.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Embedded SMAJ AI bridge (backend only; never VITE_ variables)
# Separate shared secret for individually reviewed live action capabilities
SMAJ_AI_DELEGATION_SECRET=
SMAJ_PRODUCTION_WRITES_ENABLED=false

# Standalone SMAJ AI confidential SSO client (server-only; match AI service).
SMAJ_AI_CLIENT_ID=smaj-ai
SMAJ_AI_CLIENT_SECRET=
SMAJ_AI_SSO_SECRET=
SMAJ_AI_BACKEND_URL=https://smaj-verified-delegation.onrender.com
SMAJ_AI_REDIRECT_URI=https://smaj-verified-delegation.onrender.com/api/auth/callback
SMAJ_HUB_PUBLIC_URL=https://smajpihub.com
