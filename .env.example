# WARNING: Commenting after a variable's value DOES NOT WORK in .env files.
# In other words, don't to this: `FOO=value # this is a comment`.
# This would give the value "value # this is a comment" to the FOO variable.
# You need to use single-line comments instead, e.g:
# ```
#   # this is a comment:
#   FOO=value
# ```

#
#
#

# Frontend app URL and bare domain name:
FRONTEND_URL=https://frontend.example.com
FRONTEND_DOMAIN_NAME=frontend.example.com

# Backend app URL and bare domain name:
BACKEND_URL=https://smajpihub.onrender.com
BACKEND_DOMAIN_NAME=smajpihub.onrender.com

# Set it to true to run the app in Pi Sandbox
SANDBOX_SDK=true

# Obtain the following 2 values on the Pi Developer Portal (https://develop.pinet.com in the Pi Browser).

# Domain validation key:
DOMAIN_VALIDATION_KEY=65940cc670d4e341a139a1bd862a9fd2952dad7cf2b57e1e79943fdefe69e644dcb82ac8178ac14eee8fc9af0ca2c9e1260b43d7b187465e4636fbe8048c5ff5

# Pi Platform API Key:
PI_API_KEY=todo_developer_portal

# Generate a random string, or roll your face on the keyboard to fill this value:
SESSION_SECRET=abcd1324_TODO

# MongoDB database connection details:
# Render/MongoDB Atlas production should use this full URI.
# Example: mongodb+srv://smajpihub:YOUR_PASSWORD@smajpihub.lkfvpvv.mongodb.net/smajpihub?retryWrites=true&w=majority&appName=smajpihub
MONGODB_URI=

# Legacy/local MongoDB settings used only when MONGODB_URI is empty.
MONGODB_DATABASE_NAME=demoapp
MONGODB_USERNAME=demoapp
MONGODB_PASSWORD=abcd1234


# This will be prepended to all container names.
# Changing this will make docker-compose lose track of all your containers.
# Run `docker-compose down` before changing it.
COMPOSE_PROJECT_NAME=pi-demo-app

# Set this to either "development" or "production" (XXX "staging"?):
ENVIRONMENT=production

# This directory will be used to store all persistent data needed by Docker (using volumes):
DATA_DIRECTORY=./docker-data

# URL of the Pi Platform API.
# Backend Pi API requests always use production.
PLATFORM_API_URL=https://api.minepi.com

# TMDB API Read Access Token. Keep this server-side; never expose it through VITE_* variables.
# Create one at https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=

# Cloudflare Stream credentials. Create an API token with Stream Write permission.
# These values belong on the backend only.
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# Official embeddable YouTube live channels. Keep the API key on the backend.
# Supply channel IDs (the UC... values), separated by commas.
YOUTUBE_API_KEY=
YOUTUBE_LIVE_CHANNEL_IDS=

# Sports data provider configuration. TheSportsDB development key is 123.
# Multiple league IDs can be supplied as a comma-separated list.
SPORTS_PROVIDER=thesportsdb
SPORTS_API_KEY=123
SPORTS_LEAGUE_IDS=4328
SPORTS_CACHE_SECONDS=900

# Free self-hosted automatic translation service.
TRANSLATION_API_URL=http://libretranslate:5000
TRANSLATION_API_KEY=
OPENALEX_API_KEY=
DATA_GOV_API_KEY=

# P0 rollout: set explicitly to Pi Testnet or Pi Network.
PI_NETWORK=Pi Testnet
# Database administrator initialization and application credentials must differ.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
# Backend-only credentials for protected CV uploads/downloads.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional loopback-only disposable replica-set integration test, never production.
# P0_TEST_MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
